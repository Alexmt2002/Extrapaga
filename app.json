{
  "expo": {
    "name": "Extrapaga",
    "slug": "Extrapaga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ImagenLogo.png",
    "scheme": "extrapaga",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ImagenLogo.png",
        "backgroundImage": "./assets/images/ImagenLogo.png",
        "monochromeImage": "./assets/images/ImagenLogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ImagenLogo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ImagenLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
